# ============================================================
# ULTRON – Environment Configuration Example
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME=ULTRON
APP_VERSION=0.2.0
APP_ENV=development            # development | staging | production
DEBUG=false
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_DIR=logs/

# ── LLM Provider Switch ────────────────────────────────────────
LLM_PROVIDER=nvidia             # nvidia | qwen

# ── LLM / NVIDIA NIM ─────────────────────────────────────────
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_FAST_MODEL=meta/llama-3.1-8b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=256
LLM_TIMEOUT_SECONDS=15

# ── Local Qwen / Ollama ───────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen3:4b-instruct

# ── Screen vision ────────────────────────────────────────────
# The model that looks at your screen. Separate from QWEN_MODEL: a text
# model cannot see, and installing vision should not change how ULTRON
# talks. Install it with:  ollama pull qwen2.5vl:3b
VISION_MODEL=qwen2.5vl:3b

# Speed. Ollama drops a model from RAM after five idle minutes by default,
# so every screen question reloaded several GB from disk before it could
# start. VISION_KEEP_ALIVE holds it resident; VISION_PRELOAD pays that first
# load at startup instead of on your first question. Set PRELOAD=false if you
# would rather not hold the memory until you actually ask something.
VISION_KEEP_ALIVE=30m
VISION_PRELOAD=true
# Longest edge of the screenshot sent to the model. Above ~900px you buy
# vision tokens, not legibility — and on a CPU that is seconds per question.
VISION_MAX_EDGE=896
VISION_JPEG_QUALITY=75          # 75 keeps UI text readable
# Answers are spoken in one to three sentences; anything more is decode time
# you spend listening to silence.
VISION_NUM_PREDICT=128
VISION_TIMEOUT_SECONDS=90       # a ceiling, so a stall is not a hang

# ── Speech ───────────────────────────────────────────────────
STT_ENGINE=whisper
TTS_ENGINE=piper               # piper (local) | pyttsx3 (offline)
STT_MODEL=base                 # base | small | tiny.en | medium.en
STT_DEVICE=cpu                 # cpu | cuda
STT_COMPUTE_TYPE=int8          # int8 | float32 | float16
STT_BEAM_SIZE=3
TTS_VOICE_RATE=175
TTS_VOICE_VOLUME=1.0
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=1024
SILENCE_TIMEOUT=1.0            # lower = faster response
STT_ROLLING_BUFFER_BLOCKS=5    # lower = faster start (default 5)

# ── Wake Word ────────────────────────────────────────────────
WAKEWORD_ENGINE=porcupine
WAKEWORD_KEYWORD=ultron
PICOVOICE_ACCESS_KEY=your_picovoice_key_here
# Higher = easier to trigger, for BOTH engines (0.0-1.0). Porcupine takes it
# directly; openWakeWord fires when the phrase's score beats
# (1 - sensitivity), so 0.65 means a score of 0.35 wakes it. If ULTRON takes
# several tries to hear you, run `python scripts/wakeword_tune.py`, read the
# peak score your voice actually reaches, and set sensitivity a little above
# (1 - that peak). Too high and background speech starts triggering it.
WAKEWORD_SENSITIVITY=0.65

# ── No-Wake Mode (Whisperflow style) ─────────────────────────
HOLD_TO_TALK_KEY=right_shift   # right_shift | alt | ctrl | space | f1

# ── Planner / Intent ─────────────────────────────────────────
INTENT_CONFIDENCE_THRESHOLD=0.75
MAX_PLAN_STEPS=10

# ── Security ─────────────────────────────────────────────────
SECRET_KEY=change_me_in_production_use_a_strong_random_key
